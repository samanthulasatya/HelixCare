<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://hospital.com/management/soap/generated"
           targetNamespace="http://hospital.com/management/soap/generated"
           elementFormDefault="qualified">

    <xs:element name="VerifyInsuranceRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="policyNumber" type="xs:string"/>
                <xs:element name="provider" type="xs:string"/>
                <xs:element name="claimAmount" type="xs:double"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="VerifyInsuranceResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="isVerified" type="xs:boolean"/>
                <xs:element name="coverageAmount" type="xs:double"/>
                <xs:element name="statusMessage" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
